  ],
  "decision_tables": [
    {
      "table_id": "data_centre_construction.mandatory_qualifiers",
      "version": "0.1.0",
      "inputs": ["term"],
      "rows": [
        {"when": {"term": "tested"}, "then": {"required_qualifiers": ["level", "load_percentage", "failure_scenario"]}},
        {"when": {"term": "resilience"}, "then": {"required_qualifiers": ["design_or_built_or_current_operating"]}},
        {"when": {"term": "capacity"}, "then": {"required_qualifiers": ["design_or_installed_or_available_or_available_after_redundancy"]}},
        {"when": {"term": "PUE"}, "then": {"required_qualifiers": ["design_or_guaranteed_or_measured_or_annualised", "load", "ambient"]}}
      ],
      "default_outcome": {"required_qualifiers": [], "note": "no qualifier contract for this term"},
      "authority_source": "owner lessons sheet — Section 9.3",
      "certification": "candidate",
      "provenance": {"donor_repo": "owner data-centre lessons sheet", "donor_path": "domain_packs/data_centre_construction/pack.json", "donor_symbol": "mandatory_qualifiers"}
    },
    {
      "table_id": "data_centre_construction.evidence_sufficiency",
      "version": "0.1.0",
      "inputs": ["figure_class"],
      "rows": [
        {"when": {"figure_class": "current_resilience_state"}, "then": {"acceptable": "live state record post-change", "unacceptable": "design basis statement"}},
        {"when": {"figure_class": "ist_result"}, "then": {"acceptable": "IST report at stated load with failure scenarios", "unacceptable": "component test or partial-load extrapolation"}},
        {"when": {"figure_class": "sld_currency"}, "then": {"acceptable": "as-built SLD reflecting latest change", "unacceptable": "design SLD"}},
        {"when": {"figure_class": "capacity_available"}, "then": {"acceptable": "measured capacity with redundancy reservation stated", "unacceptable": "design capacity stated as available"}},
        {"when": {"figure_class": "pue"}, "then": {"acceptable": "measured or annualised figure with load and ambient", "unacceptable": "design PUE stated as measured"}}
      ],
      "default_outcome": {"acceptable": "domain review required", "unacceptable": "not defined"},
      "authority_source": "owner lessons sheet — Section 9.1",
      "certification": "candidate",
      "provenance": {"donor_repo": "owner data-centre lessons sheet", "donor_path": "domain_packs/data_centre_construction/pack.json", "donor_symbol": "evidence_sufficiency"}
    },
    {
      "table_id": "data_centre_construction.term_traps",
      "version": "0.1.0",
      "inputs": ["term"],
      "rows": [
        {"when": {"term": "load"}, "then": {"variants": ["design", "installed", "available", "measured"], "confusion_risk": "design load quoted as what is available now"}},
        {"when": {"term": "capacity"}, "then": {"variants": ["design", "installed", "available", "available_after_redundancy"], "confusion_risk": "redundancy reservation not stated"}},
        {"when": {"term": "redundancy"}, "then": {"variants": ["N", "N+1", "2N", "2(N+1)"], "confusion_risk": "N+1 counted as a component instead of a claim"}},
        {"when": {"term": "Tier"}, "then": {"variants": ["design certification"], "confusion_risk": "Tier quoted as an operating guarantee"}},
        {"when": {"term": "tested"}, "then": {"variants": ["L1-L5 at load %"], "confusion_risk": "bare 'tested' with no level or load"}},
        {"when": {"term": "PUE"}, "then": {"variants": ["design", "guaranteed", "measured", "annualised"], "confusion_risk": "design PUE stated as measured"}},
        {"when": {"term": "power"}, "then": {"variants": ["nameplate", "actual draw"], "confusion_risk": "nameplate used as actual"}},
