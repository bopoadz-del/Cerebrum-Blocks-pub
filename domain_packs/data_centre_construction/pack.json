{
  "manifest": {
    "domain_id": "data_centre_construction",
    "version": "0.1.0",
    "name": "Data Centre Construction — Governance Reasoning Layer",
    "description": "The governance spine of data-centre delivery, encoded from the owner's lessons sheet: refusal rules (what the platform must NOT answer from design), the four absolute rules, mandatory qualifiers per term, evidence sufficiency, staleness triggers, derivation limits, authority precedence, and term traps. LAYER 1 generalizes to any data centre. LAYER 2 (one facility's numbers) is included only as a labeled worked example — 0.4 MW, 2N, 45-min UPS — NOT a universal kit. The sheet's blank tables (lead times, costs, per-level proves/does-not-prove, IST scenarios, live works, blockers, failure shapes) are deliberately absent rather than fabricated.",
    "certification": "candidate",
    "donor_repo": "owner data-centre lessons sheet (single facility)",
    "donor_commit": "n/a — owner-directed transcription"
  },
  "ontology": {
    "terms": {
      "tested": "a claim that something was tested; never emit without level (L1-L5) and load %",
      "resilience": "a claim about survivability; always as-designed / as-built / as-currently-operating",
      "capacity": "design | installed | available | available_after_redundancy",
      "PUE": "design | guaranteed | measured | annualised",
      "N_plus_1": "a resilience claim, not a component to count",
      "Tier": "design certification level, not an operating guarantee",
      "IST": "integrated systems test; a functional test, not a resilience proof",
      "L1_L5": "testing levels; L5 requires client acceptance",
      "SLD": "single line diagram; the as-built record of the power system",
      "MOP": "method of procedure; the controlled-change document"
    },
    "mandatory_qualifiers": {
      "tested": ["level", "load_percentage", "failure_scenario"],
      "resilience": ["design_or_built_or_current_operating"],
      "capacity": ["design_or_installed_or_available_or_available_after_redundancy"],
      "PUE": ["design_or_guaranteed_or_measured_or_annualised", "load", "ambient"]
    },
    "authority_precedence": [
      "statutory_safety",
      "authority_approval",
      "client_standard",
      "certification",
      "design_basis",
      "as_built_sld",
      "commissioning_script",
      "manufacturer",
      "mop",
      "site_instruction"
    ],
    "test_levels": ["L1", "L2", "L3", "L4", "L5"]
  },
  "entities": {
    "claim": {"fields": ["term", "qualifiers", "source", "asserted_at"]},
    "test_result": {"fields": ["level", "load_percentage", "failure_scenario", "ist_result"]},
    "facility_profile": {
      "note": "WORKED EXAMPLE ONLY — one facility from the sheet, not a general kit.",
      "design_power_kw": 400,
      "redundancy": "2N",
      "ups_autonomy_minutes": 45
    }
  },
  "permissions": {
    "assert_tested": ["commissioning_authority", "authority_approval"],
    "declare_resilience": ["authority_approval"],
    "declare_readiness": [],
    "approve_mop": ["critical_environment_manager", "authority_approval"],
    "skip_test": []
  },
  "evidence_policy": {
    "figure_classes": {
      "current_resilience_state": {"acceptable": ["live state record post-change"], "unacceptable": ["design basis statement"]},
      "ist_result": {"acceptable": ["ist report at stated load with failure scenarios"], "unacceptable": ["component test result", "partial-load extrapolation"]},
      "sld_currency": {"acceptable": ["as-built SLD reflecting latest change"], "unacceptable": ["design SLD"]},
      "capacity_available": {"acceptable": ["measured capacity with redundancy reservation stated"], "unacceptable": ["design capacity stated as available"]},
      "pue": {"acceptable": ["measured or annualised figure with load and ambient"], "unacceptable": ["design PUE stated as measured"]},
      "tested_claim": {"acceptable": ["level + load % + failure scenario"], "unacceptable": ["bare 'tested'"]},
      "readiness_declaration": {"acceptable": ["none — never emitted"], "unacceptable": ["any"]}
    }
  },
  "authority_sources": {
    "statutory_safety": "statutory and safety requirements — outranks everything",
    "authority_approval": "approving authority sign-off",
    "client_standard": "the client's own standard",
    "certification": "Tier or equivalent certification",
    "design_basis": "what was designed",
    "as_built_sld": "what was actually built",
    "commissioning_script": "the agreed test scripts",
    "manufacturer": "vendor documentation",
    "mop": "method of procedure",
    "site_instruction": "site-level instruction — lowest"
  },
  "refusal_policy": {
    "named_reasons": {
      "requires_live_resilience_state": "not answerable from design; needs the live resilience state",
      "requires_approved_mop_and_authority": "needs an approved MOP and authority; refer to the critical environment manager",
      "requires_ist_at_load": "a functional test does not prove ride-through; needs IST at load",
      "requires_l5_and_client_acceptance": "multi-party decision; needs L5 and client acceptance",
      "requires_commissioning_authority": "needs the commissioning authority and the client standard",
      "requires_measured_capacity": "design capacity is not available capacity"
    },
    "absolute_rules": [
      "never emit tested without level and load percentage",
      "never state resilience without as-designed / as-built / as-currently-operating",
      "never quote capacity without stating whether redundancy is reserved",
      "never declare ready for IT load"
    ],
    "derivation_limits": [
      "never infer facility performance from individual system tests",
      "never extrapolate partial-load IST to full load",
      "never infer current resilience from the design basis"
    ]
  },
  "formulas": [
    {
      "formula_id": "data_centre_construction.pue",
      "name": "pue",
      "domain": "data_centre_construction",
      "version": "0.1.0",
      "description": "Power usage effectiveness = total facility power / IT load. The RESULT is only a number: the qualifier (design/guaranteed/measured/annualised), load and ambient must accompany it or the claim is refused by R-DC-QUALIFIER-PUE.",
      "expression": "total_facility_power / it_load",
      "inputs": [
        {"name": "total_facility_power", "type": "number", "min": 0},
        {"name": "it_load", "type": "number", "min": 0}
      ],
      "output": {"type": "number", "units": "ratio"},
      "units": {"total_facility_power": "kW", "it_load": "kW", "output": "ratio"},
      "currency": null,
      "precision": 3,
      "rounding": "half_even",
      "preconditions": ["it_load gt 0", "total_facility_power ge 0"],
      "edge_cases": ["600 kW / 400 kW = 1.5", "it_load 0 refused (division by zero)"],
      "unsupported_conditions": ["non-numeric input", "zero or negative IT load"],
      "authority_source": "owner lessons sheet — PUE definition (generalizes to any DC)",
      "implementation": "data_centre_construction.pue",
      "verification_oracle": "tests/core/test_domain_pack_data_centre.py — 600/400 = 1.5; 0 load refused",
      "certification": "candidate",
      "provenance": {"donor_repo": "owner data-centre lessons sheet", "donor_commit": "n/a", "donor_path": "domain_packs/data_centre_construction/pack.json", "donor_symbol": "pue"}
    },
    {
      "formula_id": "data_centre_construction.test_load_percentage",
      "name": "test_load_percentage",
      "domain": "data_centre_construction",
      "version": "0.1.0",
      "description": "The load a test achieved as a percentage of design load — the number that must accompany every 'tested' claim.",
      "expression": "(achieved_load / design_load) * 100",
      "inputs": [
        {"name": "achieved_load", "type": "number", "min": 0},
        {"name": "design_load", "type": "number", "min": 0}
      ],
      "output": {"type": "number", "units": "percent"},
      "units": {"achieved_load": "kW", "design_load": "kW", "output": "percent"},
      "precision": 1,
      "rounding": "half_even",
      "preconditions": ["design_load gt 0", "achieved_load ge 0"],
      "edge_cases": ["300 / 400 = 75.0%"],
      "unsupported_conditions": ["zero design load"],
      "authority_source": "owner lessons sheet — test load percentage",
      "implementation": "data_centre_construction.test_load_percentage",
      "verification_oracle": "tests/core/test_domain_pack_data_centre.py — 300/400 = 75.0",
      "certification": "candidate",
      "provenance": {"donor_repo": "owner data-centre lessons sheet", "donor_commit": "n/a", "donor_path": "domain_packs/data_centre_construction/pack.json", "donor_symbol": "test_load_percentage"}
    }
  ],
  "rules": [
    {
