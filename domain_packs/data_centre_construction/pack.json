      "version": "0.1.0",
      "conditions": [{"field": "assertion_kind", "op": "eq", "value": "tested_claim"}],
      "decision": {"action": "refuse", "reason": "requires_test_qualifiers", "message": "never emit 'tested' without level (L1-L5) and load percentage"},
      "severity": "critical",
      "precedence": 100,
      "authority_source": "owner lessons sheet — Section 15 absolute rules",
      "evidence_requirements": ["level", "load_percentage", "failure_scenario"],
      "refusal_behavior": "refuse",
      "certification": "candidate",
      "provenance": {"donor_repo": "owner data-centre lessons sheet", "donor_path": "domain_packs/data_centre_construction/pack.json", "donor_symbol": "R-DC-ABSOLUTE-TESTED"}
    },
    {
      "rule_id": "R-DC-ABSOLUTE-RESILIENCE",
      "version": "0.1.0",
      "conditions": [{"field": "assertion_kind", "op": "eq", "value": "resilience_claim"}],
      "decision": {"action": "refuse", "reason": "requires_resilience_basis", "message": "never state resilience without as-designed / as-built / as-currently-operating"},
      "severity": "critical",
      "precedence": 100,
      "authority_source": "owner lessons sheet — Section 15 absolute rules",
      "refusal_behavior": "refuse",
      "certification": "candidate",
      "provenance": {"donor_repo": "owner data-centre lessons sheet", "donor_path": "domain_packs/data_centre_construction/pack.json", "donor_symbol": "R-DC-ABSOLUTE-RESILIENCE"}
    },
    {
      "rule_id": "R-DC-ABSOLUTE-CAPACITY",
      "version": "0.1.0",
      "conditions": [{"field": "assertion_kind", "op": "eq", "value": "capacity_claim"}],
      "decision": {"action": "refuse", "reason": "requires_redundancy_reservation", "message": "never quote capacity without stating whether redundancy is reserved"},
      "severity": "critical",
      "precedence": 100,
      "authority_source": "owner lessons sheet — Section 15 absolute rules",
      "refusal_behavior": "refuse",
      "certification": "candidate",
      "provenance": {"donor_repo": "owner data-centre lessons sheet", "donor_path": "domain_packs/data_centre_construction/pack.json", "donor_symbol": "R-DC-ABSOLUTE-CAPACITY"}
