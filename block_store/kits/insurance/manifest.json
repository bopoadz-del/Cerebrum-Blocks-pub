{
  "learning_engine_enabled": false,
  "id": "insurance",
  "name": "Insurance Distribution & Agency Suite",
  "version": "2.0.0",
  "description": "Distribution and agency suite for insurance carriers, MGAs, brokers, and agencies. Keeps insurance_v2 as the Layer-1 document analysis block while adding producer records, hierarchy management, commissions, routing, retention, incentives, HKIA GN16 checks, bordereaux ingest, and distribution analytics.",
  "status": "available",
  "serves_verticals": ["insurance"],
  "build_ready": true,
  "author": "bopoadz-del",
  "tags": [
    "domain",
    "container",
    "insurance",
    "distribution",
    "agency"
  ],
  "source": {
    "repo": "https://github.com/bopoadz-del/Cerebrum-Blocks",
    "ref": "main",
    "publish_script": "scripts/publish_insurance_kit.py"
  },
  "container": {
    "class": "app.containers.insurance.InsuranceContainer",
    "default_chat_prompt": null
  },
  "blocks": [
    "pdf",
    "ocr",
    "chat",
    "image",
    "insurance_v2",
    "formula_executor_v2",
    "agency_hierarchy",
