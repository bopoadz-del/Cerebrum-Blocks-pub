# Cerebrum Blocks - environment variables read by app/ (copy to .env and fill in).
# Empty values are placeholders; never commit real values.

# Required: the secrets block refuses to start without it (see README Quick start).
CEREBRUM_MASTER_KEY=

# The platform's LLM provider key; omit and those paths return an offline/skip result.
KIMI_API_KEY=

# Comma-separated allowed CORS origins (empty = safe defaults).
CORS_ORIGINS=

# Directory for uploaded files and runtime data.
DATA_DIR=./data

# Public base URL for generated file links.
API_BASE_URL=

# Max upload size in bytes.
MAX_UPLOAD_SIZE=10485760

# Optional persistence backends (queue block uses Redis when set).
DATABASE_URL=
REDIS_URL=

# Out-of-process sandbox runner for blocks that must not run in the API worker.
SANDBOX_RUNNER_URL=http://localhost:8001

# DEBUG | INFO | WARNING | ERROR, and json | text.
LOG_LEVEL=INFO
LOG_FORMAT=json
