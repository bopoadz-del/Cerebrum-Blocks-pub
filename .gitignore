*.pem
*.key

# pytest
.pytest_cache/
.coverage

# mypy
.mypy_cache/
.dmypy.json
dmypy.json
frontend/node_modules

# Secrets vault (plaintext removed - see vault/secrets.tar.gz.gpg)
.ssh/
.render/

vault/secrets.tar.gz
claudebot/KEYS.md
frontend/dist

# Runtime data written under DATA_DIR (default ./data) at runtime: the SQLite
# files (database.py, auth.py, api_keys.py), storage/vector blocks, captures and
# uploads. Anchored to the repo root and listed explicitly (ST-7): the old bare
# `data/` rule also matched app/data/ and dropped source the code reads.
/data/*.db
/data/*.db-wal
/data/*.db-shm
/data/storage/
/data/vector/
/data/captures/
/data/uploads/
# Written by block_validation.py (DEFAULT_CERTIFICATION_STORE_PATH) at runtime.
/data/block_certifications.json
# Install state / kit registry written by container_kit_store.py and domain_kit_registry.py.
/data/installed_container_kits.json
/data/domain_kit_registry.json
# Automotive foundation pack build artifacts (harvests, embeddings, indexes).
# The old blanket *.csv / *.jsonl rules dropped authored kit data; the runtime
# jsonl writers go to storage/ (grounding verdicts) and indexes/ (rag records).
*.zip
harvests/
embeddings/
indexes/
# Never commit publisher private keys.
data/publishers/*.key
uploads/

# Carry-Back runtime proposal packages (never commit local runs)
.carry_back/

# Audit / shell logs written by the shell_audit hook during dev.
logs/

# Local dev logs
*.log
backend.log
mock_backend.log
frontend_dev.log
frontend_e2e.log

# Portable local Postgres binaries (large, generated)
.postgres/

# Temporary diagnostic scripts
diagnose_retrieval.py

# Odd artifacts
=1.6.0
storage/
# ...but block_registry/storage is a Store PLATFORM BLOCK, not a runtime dir.
# The bare `storage/` rule above silently dropped it from the public mirror in
# the r4 scrub, which left the steward estate_registry capability (and any other
# capability whose block_ids include `storage`) non-dual-registered.
!block_registry/storage/
!block_registry/storage/**

# MEP kit fixture: 47MB public model, fetched by fixtures/fetch_fixtures.sh
block_store/kits/mep_coordination/fixtures/*.ifc

# MEP kit: acceptance run output (contains 47MB model clones)
block_store/kits/mep_coordination/acceptance_out/

# Owner-supplied client models — never committed
block_store/kits/mep_coordination/fixtures/owner_models/

# generated at run time (carry_back/seeds.py); never committed
fixtures/carry_back/
# fleet operations artifacts stay out of the repository
FLEET_OPS/
